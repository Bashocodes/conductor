{
  "name": "@conductor-motion/conductor",
  "version": "0.1.0-alpha.0",
  "description": "The deterministic craft layer for Adobe MCP servers.",
  "private": true,
  "license": "MIT",
  "author": "KALAI LABS",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bashocodes/conductor.git"
  },
  "homepage": "https://github.com/Bashocodes/conductor#readme",
  "bugs": {
    "url": "https://github.com/Bashocodes/conductor/issues"
  },
  "keywords": [
    "mcp",
    "adobe",
    "after-effects",
    "motion-design",
    "recipes",
    "automation"
  ],
  "type": "module",
  "bin": {
    "conductor": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "assets",
    "dist",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-console-assets.mjs",
    "serve": "pnpm build && node dist/cli.js serve --no-open",
    "build:console": "pnpm build && node scripts/emit-static-console.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.2",
    "commander": "^14.0.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
